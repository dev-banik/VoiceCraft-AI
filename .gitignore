# Locally downloaded install builds (see dist/README.md) — not committed:
# GitHub hard-rejects pushes over 100MB (the armeabi-v7a release APK is
# ~103.6MB) and binaries like this don't belong in git history anyway.
# Re-fetched from the latest successful CI run after every change instead.
/dist/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# VS Code
.vscode/*
!.vscode/extensions.json

# Flutter/Dart/Pub related
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/.gradle
/android/captures/
/android/gradlew
/android/gradlew.bat
/android/local.properties
/android/**/GeneratedPluginRegistrant.java
android/key.properties

# iOS
/ios/Flutter/.last_build_id
/ios/Flutter/App.framework
/ios/Flutter/Flutter.framework
/ios/Flutter/Flutter.podspec
/ios/Flutter/Generated.xcconfig
/ios/Flutter/ephemeral
/ios/Flutter/app.flx
/ios/Flutter/app.zip
/ios/Flutter/flutter_assets/
/ios/Flutter/flutter_export_environment.sh
/ios/ServiceDefinitions.json
/ios/Runner/GeneratedPluginRegistrant.*
/ios/Pods/
/ios/.symlinks/
**/xcuserdata/
*.xcworkspace/xcuserdata/

# Firebase
# NOTE: google-services.json and GoogleService-Info.plist are intentionally
# NOT ignored — this repo ships placeholder versions (matching the dummy
# keys in lib/firebase_options.dart) so `flutter build apk` succeeds out of
# the box. Replace both with the real files from `flutterfire configure`
# before shipping; see docs/DEPLOYMENT.md.
lib/firebase_options.dart.local
firebase-debug.log
.firebase/

# Coverage
coverage/

# Secrets
*.jks
*.keystore
*.p12
*.env
.env*
!*.env.example

# Downloaded APKs for sideloading (see tools/fetch-apk.ps1) — same reason as
# /dist/ above: these are CI build outputs, well over GitHub's 100MB push
# limit, and re-fetchable any time.
/install apk/
