rules_version = '2';

// Layout: users/{uid}/recordings/{recordingId}.<ext>
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/recordings/{fileName} {
      // 500MB cap per file protects against runaway uploads (spec calls for
      // supporting 2+ hour recordings; at 192kbps AAC that is well under
      // 200MB, so this leaves generous headroom without being unbounded).
      allow read, write: if isOwner(uid)
        && request.resource.size < 500 * 1024 * 1024;
      allow delete: if isOwner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
